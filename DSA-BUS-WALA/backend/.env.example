# ── Server ──
PORT=5000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database ──
MONGO_URI=mongodb://localhost:27017
DB_NAME=TrackMatev1

# ── Auth ──
JWT_SECRET=change_this_to_a_long_random_string

# ── Tracking / ETA ──
OSRM_BASE_URL=http://router.project-osrm.org
STALE_TRIP_HOURS=12

# ── Push Notifications (generate with: npx web-push generate-vapid-keys) ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@example.com

# ── Email (Brevo/SendGrid etc.) ──
BREVO_API_KEY=
EMAIL_USER=

# ── GPS Ingestion (REAL bus coordinates only; no mock data by default) ──
# provider: none | http | webhook  (dummy is FOR TESTING ONLY, disabled by default)
GPS_PROVIDER=none
GPS_PROVIDER_URL=https://your-real-gps-provider.example.com/api/vehicles
GPS_PROVIDER_TOKEN=your-shared-provider-token
GPS_POLL_INTERVAL_MS=5000

# ── Live-Data Excel Export / Storage Pipeline ──
# Directory where hourly/daily partitioned Excel files are written.
EXCEL_OUTPUT_DIR=./exports
# Partition mode: 'hourly' (default) or 'daily'
EXCEL_PARTITION_MODE=hourly
# How often the background exporter flushes the queue to Excel (ms).
EXCEL_FLUSH_INTERVAL_MS=5000
# Max queue size before oldest records are dropped (prevents memory blow-ups).
EXCEL_MAX_QUEUE=10000

# ── GPS Record Retention / Archival ──
# Old LocationEvent GPS records older than this many days are purged by the worker.
GPS_RETENTION_DAYS=7
